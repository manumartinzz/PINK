# Copie este arquivo para ".env" e preencha seus dados.
# Chave da API (opcional — sem ela a Pink usa o modo offline inteligente):
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Nome da sua assistente (ex: Pink, Aurora, Luna, Vênus)
PINK_ASSISTANT_NAME=Pink

# Como a assistente deve chamar você
PINK_USER_NAME=

# Personalidade: carinhosa | jarvis | divertida | estudos
PINK_PERSONALITY=carinhosa

# Cidade padrão para previsão do tempo
PINK_CITY=Curitiba

# Modelo usado quando houver chave da API Anthropic
PINK_MODEL=claude-sonnet-5-5

# Host e porta local (127.0.0.1 aceita conexões apenas do seu computador)
PINK_HOST=127.0.0.1
PINK_PORT=8765
