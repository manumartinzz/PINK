# Copie este arquivo para ".env" e preencha seus dados.
# Chave da API: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Como a Pink deve chamar você
PINK_USER_NAME=

# Modelo usado no cérebro da Pink
PINK_MODEL=claude-sonnet-5-5

# Porta local (a Pink só aceita conexões do seu próprio computador)
PINK_PORT=8765
